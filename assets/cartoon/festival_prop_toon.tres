nodes/fragment/5/node = SubResource("VertexColorWeight")
nodes/fragment/5/position = Vector2(-740, 420)
nodes/fragment/6/node = SubResource("Paint")
nodes/fragment/6/position = Vector2(-280, -20)
nodes/fragment/6/size = Vector2(400, 250)
nodes/fragment/6/input_ports = "0,4,base_color;1,4,base_texture;2,4,vertex_color;3,0,vertex_weight;"
nodes/fragment/6/output_ports = "0,4,albedo;"
nodes/fragment/6/expression = "albedo = base_color * base_texture * mix(vec3(1.0), vertex_color, vertex_weight);"
