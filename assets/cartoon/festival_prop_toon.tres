nodes/light/8/node = SubResource("LightColor")
nodes/light/8/position = Vector2(-430, 300)
nodes/light/9/node = SubResource("Attenuation")
nodes/light/9/position = Vector2(-430, 445)
nodes/light/10/node = SubResource("CelBands")
nodes/light/10/position = Vector2(-90, -125)
nodes/light/10/size = Vector2(455, 325)
nodes/light/10/input_ports = "0,0,facing;1,0,midtone_edge;2,0,highlight_edge;3,0,edge_softness;4,4,light_color;5,0,attenuation;"
nodes/light/10/output_ports = "0,4,diffuse;"
nodes/light/10/expression = "float width = max(edge_softness, 0.001);
float high_edge = max(highlight_edge, midtone_edge + width);
float mid = smoothstep(midtone_edge - width, midtone_edge + width, facing);
float high = smoothstep(high_edge - width, high_edge + width, facing);
diffuse = DIFFUSE_LIGHT + light_color * attenuation * (0.20 * mid + 0.24 * high) / PI;"
