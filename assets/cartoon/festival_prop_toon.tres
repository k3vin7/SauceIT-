nodes/light/5/node = SubResource("MidtoneEdge")
nodes/light/5/position = Vector2(-830, 15)
nodes/light/6/node = SubResource("HighlightEdge")
nodes/light/6/position = Vector2(-830, 210)
nodes/light/7/node = SubResource("EdgeSoftness")
