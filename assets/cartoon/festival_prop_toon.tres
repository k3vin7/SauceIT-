[resource]
resource_name = "Festival Prop Cel Shading"
modes/cull = 2
modes/specular = 2
nodes/fragment/0/position = Vector2(280, 0)
nodes/fragment/2/node = SubResource("BaseColor")
nodes/fragment/2/position = Vector2(-740, -230)
